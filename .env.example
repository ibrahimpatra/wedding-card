# ─────────────────────────────────────────────────────────────────
# Ibrahim & Zenab Wedding Invite — Environment Variables
#
# HOW TO USE:
#   1. Copy this file and rename to  .env.local
#   2. Fill in YOUR values below
#   3. NEVER commit .env.local to git (it's in .gitignore)
#   4. For Firebase Hosting deployment, set these same vars in:
#      Firebase Console → Hosting → your project → Environment config
#      OR just keep them in .env.local and run  npm run build  locally
#      before  firebase deploy
#
# ─────────────────────────────────────────────────────────────────

# Firebase Realtime Database URL
# Get it from: Firebase Console → Realtime Database → the URL at the top
# e.g.  https://ibrahim-weds-zenab-default-rtdb.firebaseio.com
REACT_APP_FIREBASE_DB_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com

# Set to false to pause analytics tracking without redeploying
REACT_APP_ANALYTICS_ENABLED=true
